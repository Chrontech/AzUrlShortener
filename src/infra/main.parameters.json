{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "CustomDomain": {
        "value": "${AZURE_CUSTOM_DOMAIN}"
      },
      "DefaultRedirectUrl": {
        "value": "${AZURE_DEFAULT_REDIRECT_URL}"
      },
      "ChroniclePortalUrl": {
        "value": "${AZURE_CHRONICLE_PORTAL_URL}"
      },
      "ChronicleUriScheme": {
        "value": "${AZURE_CHRONICLE_URI_SCHEME}"
      },
      "ChronicleIosAppId": {
        "value": "${AZURE_CHRONICLE_IOS_APP_ID}"
      },
      "ChronicleAndroidPackage": {
        "value": "${AZURE_CHRONICLE_ANDROID_PACKAGE}"
      },
      "ChronicleAndroidSigningFingerprints": {
        "value": "${AZURE_CHRONICLE_ANDROID_SIGNING_FINGERPRINTS}"
      },
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      }
    }
  }
  
